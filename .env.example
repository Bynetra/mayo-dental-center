# Resend API Key for contact form email delivery (optional - falls back gracefully to WhatsApp if not set)
RESEND_API_KEY=re_your_api_key_here

# Recipient email address for patient contact inquiries
CONTACT_TO_EMAIL=info@mayodentalcenter.com

# Public site canonical base URL
NEXT_PUBLIC_SITE_URL=https://www.mayodentalcenter.com

# External booking portal URL (if applicable)
NEXT_PUBLIC_BOOKING_URL=/book

# Indexing toggle (false for preview/demo deployment, true for production release)
NEXT_PUBLIC_ALLOW_INDEXING=false

